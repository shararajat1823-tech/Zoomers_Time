# Zoomers backend — environment configuration sample.
# Copy to a real environment configuration (never commit real values).
# In ASP.NET Core, ':' in a key becomes '__' as an environment variable.

# ---- Database ----
# PostgreSQL connection string.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=zoomers_dev;Username=zoomers;Password=CHANGE_ME

# ---- JWT ----
# Signing key MUST be at least 32 bytes and kept secret (use a secret manager in prod).
Jwt__SigningKey=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
Jwt__Issuer=zoomers
Jwt__Audience=zoomers.clients
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ---- Rate limiting (optional; sane defaults apply if unset) ----
RateLimiting__AuthPermitLimit=10
RateLimiting__AuthWindowSeconds=60
RateLimiting__GlobalPermitLimit=200
RateLimiting__GlobalWindowSeconds=60

# ---- Media (local dev storage) ----
Media__Local__RootPath=/var/tmp/zoomers-media
Media__Local__PublicBaseUrl=/api/v1/media/local
Media__Local__SignedUrlMinutes=15
