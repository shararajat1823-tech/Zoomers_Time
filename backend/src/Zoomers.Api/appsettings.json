{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "zoomers",
    "Audience": "zoomers.clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "PasswordResetTokenLifetime": "01:00:00"
  },
  "Media": {
    "Local": {
      "PublicBaseUrl": "/api/v1/media/local",
      "SignedUrlMinutes": 15
    },
    "S3": {
      "ServiceUrl": "",
      "Region": "auto",
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "",
      "ForcePathStyle": true,
      "UploadUrlMinutes": 15,
      "DownloadUrlMinutes": 60
    }
  },
  "AllowedHosts": "*"
}
